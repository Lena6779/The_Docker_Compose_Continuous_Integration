# .env.example: copy this file to .env and fill in your own values
# Docker Compose loads .env into the backend container via env_file

# Ollama (use the service name "ollama" inside Docker)
OLLAMA_URL=http://ollama:11434
MODEL_NAME=llama3.2:1b

# ChromaDB (path is inside the container; mounted as the chroma_data volume)
CHROMA_PATH=/app/chroma_data
COLLECTION_NAME=documents

# RAG settings
MAX_RESULTS=5
CONFIDENCE_THRESHOLD=1.0

# App settings
DEBUG=true
DOCS_DIRECTORY=/app/docs
PYTHONUNBUFFERED=1

# Secrets (optional; never commit real keys)
OPENAI_API_KEY=your-openai-api-key-here
